digraph flow {
 graph [rankdir=TB, bgcolor="white", nodesep="0.35", ranksep="0.42", pad="0.22"];
 node [shape=box, style="rounded,filled", fillcolor="#f3f6fb", color="#506783", fontname="Arial", fontsize=12, margin="0.13,0.1"];
 edge [color="#60758a", arrowsize=0.7, fontname="Arial", fontsize=10];
 start [label="User request"];
 parse [label="Intent classification + food / portion parsing"];
 retrieve [label="Retrieve sourced nutrient candidates"];
 reliable [shape=diamond,label="Enough verified\ndata and portion?",fillcolor="#fff6e8"];
 clarify [label="Ask focused question / explain unknown", fillcolor="#fff2e9"];
 calculate [label="Deterministic kcal & macro calculation"];
 safe [shape=diamond,label="Safety & evidence check",fillcolor="#fff6e8"];
 explain [label="Cautious response / escalation",fillcolor="#fff2e9"];
 confirm [label="Show estimated range, sources & assumptions"];
 commit [shape=diamond,label="User confirms log?",fillcolor="#fff6e8"];
 save [label="Update daily log + optional goal summary"];
 done [label="End / await new request"];
 start->parse->retrieve->reliable;
 reliable->clarify [label="No"];
 clarify->retrieve [label="new details",style=dashed];
 clarify->done [label="cannot estimate",style=dashed];
 reliable->calculate [label="Yes"];
 calculate->safe;
 safe->explain [label="Concern"];
 explain->done;
 safe->confirm [label="OK"];
 confirm->commit;
 commit->save [label="Yes"];
 commit->done [label="No"];
 save->done;
}
